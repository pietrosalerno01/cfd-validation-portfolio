# ============================================================
# Top-level folders that must not be published
# ============================================================
# OpenFOAM tutorial used only to test the installation
/test_airFoil2D/

# NASA TMR grids: large and downloadable (see SOURCES.md)
/naca0012/grids/

# Local mirror of the TMR SA verification web page (values transcribed in tmr_sa_alpha10.md)
/naca0012/reference_data/naca0012numerics_val_sa/

# ============================================================
# OpenFOAM: keep inputs, ignore outputs
# ============================================================
# Time directories (e.g. 100/, 2500/, 0.5/) inside any case
**/cases/**/[0-9]*/
# ...except the initial/boundary conditions
!**/cases/**/0/
!**/cases/**/0.orig/

# Parallel decomposition
processor*/

# Function-object output (forces, yPlus, residuals...)
postProcessing/

# Mesh generated by scripts (plot3dToFoam, snappyHexMesh)
**/constant/polyMesh/

# Solver logs and ParaView marker files
*.log
log.*
*.foam

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
.pytest_cache/