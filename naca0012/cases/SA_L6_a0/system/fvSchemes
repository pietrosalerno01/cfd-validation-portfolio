FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
    grad(nuTilda)  cellLimited Gauss linear 1; 
}

divSchemes
{
    default         none;

    div(phi,U)      bounded Gauss linearUpwind grad(U);

    div(phi,nuTilda) bounded Gauss linearUpwind grad(nuTilda); // 2nd order, consistent with FUN3D; CFL3D reference uses 1st order

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    // Max non-orthogonality ~80 deg on the wake cut (checkMesh, L6):
    // limit explicit correction to 0.5x the orthogonal part
    default         Gauss linear limited corrected 0.33;
}


interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.33;
}

wallDist
{
    // Exact search-tree distance: d enters the SA destruction term
    method          exactDistance;
}


